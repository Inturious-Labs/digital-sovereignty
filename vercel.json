{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "HUGO_VERSION": "0.148.2"
    }
  },
  "buildCommand": "hugo --minify --gc",
  "outputDirectory": "public",
  "framework": "hugo",
  "crons": [
    {
      "path": "/api/rebuild",
      "schedule": "0 14 * * *"
    }
  ]
}
